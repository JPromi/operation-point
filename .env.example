# Image tag (latest, 1.0.1, main, ...)
IMAGE_TAG=latest

# Database (used by the bundled postgres container and the app)
# DB_HOST/DB_PORT are set to the postgres container in docker-compose.yml
DB_NAME=operation_point
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Public URL of the application (used for file links)
APP_DOMAIN=https://example.com

# Crawler
CRAWLER_TYROL_TOKEN=your-fastapi-token

# Optional
# JPA_DDL_AUTO=update
# SWAGGER_ENABLED=true
# MAX_FILE_SIZE=32GB
# JAVA_OPTS=-Xmx512m
